{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envfactory.local/schema/gold-sidecar-v1.json",
  "title": "EnvFactory task-local gold graph sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "seed",
    "environment_identifiers",
    "query",
    "gold_tool_sequence",
    "gold_tool_set",
    "dependency_depth",
    "required_tool_nodes",
    "dependency_edges",
    "parameters",
    "initial_scenario",
    "expected_final_scenario",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "envfactory_gold_sidecar_v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "environment_identifiers": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "turn_index",
        "text"
      ],
      "properties": {
        "query_id": {
          "type": "string"
        },
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      }
    },
    "gold_tool_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "tool_id",
          "tool_name",
          "server_id"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "tool_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "server_id": {
            "type": "string"
          }
        }
      }
    },
    "gold_tool_set": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependency_depth": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "unknown"
        }
      ]
    },
    "required_tool_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "tool_name",
          "server_id",
          "sequence_positions"
        ],
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "server_id": {
            "type": "string"
          },
          "sequence_positions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "edge_type",
          "graph_provenance",
          "dependency_depth",
          "producer_tool",
          "producer_output_parameter",
          "consumer_tool",
          "consumer_input_parameter",
          "required",
          "optional"
        ],
        "properties": {
          "edge_id": {
            "type": "string"
          },
          "edge_type": {
            "type": "string"
          },
          "graph_provenance": {
            "type": "string"
          },
          "dependency_depth": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "unknown"
              }
            ]
          },
          "producer_tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_id",
              "tool_name"
            ],
            "properties": {
              "tool_id": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              }
            }
          },
          "producer_output_parameter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter_id",
              "parameter_name",
              "user_provided"
            ],
            "properties": {
              "parameter_id": {
                "type": "string"
              },
              "parameter_name": {
                "type": "string"
              },
              "user_provided": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "const": "unknown"
                  }
                ]
              }
            }
          },
          "consumer_tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_id",
              "tool_name"
            ],
            "properties": {
              "tool_id": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              }
            }
          },
          "consumer_input_parameter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter_id",
              "parameter_name",
              "user_provided"
            ],
            "properties": {
              "parameter_id": {
                "type": "string"
              },
              "parameter_name": {
                "type": "string"
              },
              "user_provided": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "const": "unknown"
                  }
                ]
              }
            }
          },
          "required": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "optional": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter_id",
          "tool_id",
          "tool_name",
          "role",
          "parameter_name",
          "user_provided",
          "required",
          "optional"
        ],
        "properties": {
          "parameter_id": {
            "type": "string"
          },
          "tool_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "input",
              "output"
            ]
          },
          "parameter_name": {
            "type": "string"
          },
          "user_provided": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "required": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "optional": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          }
        }
      }
    },
    "initial_scenario": {},
    "expected_final_scenario": {},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "relevant_subgraph_only",
        "stable_ids_use_python_object_identity",
        "metadata_preservation_point"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "relevant_subgraph_only": {
          "const": true
        },
        "stable_ids_use_python_object_identity": {
          "const": false
        },
        "metadata_preservation_point": {
          "type": "string"
        }
      }
    }
  }
}
