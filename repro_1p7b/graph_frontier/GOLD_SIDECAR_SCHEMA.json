{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envfactory.local/schema/gold-sidecar-v1.json",
  "title": "EnvFactory task-local gold graph sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "seed",
    "environment_identifiers",
    "query",
    "gold_tool_sequence",
    "gold_tool_set",
    "dependency_depth",
    "required_tool_nodes",
    "dependency_edges",
    "parameters",
    "initial_scenario",
    "expected_final_state",
    "expected_final_scenario",
    "provenance",
    "dependency_semantics",
    "alternative_dependency_groups",
    "expected_final_state_source",
    "selected_dependency_trace_present",
    "dependency_resolution",
    "cross_turn_dependency",
    "cross_turn_dependencies",
    "structural_diagnosis_eligible",
    "probe_eligibility"
  ],
  "properties": {
    "schema_version": {
      "const": "envfactory_gold_sidecar_v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "environment_identifiers": {
      "oneOf": [
        {
          "const": "unknown"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "turn_index",
        "text"
      ],
      "properties": {
        "query_id": {
          "type": "string"
        },
        "turn_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      }
    },
    "gold_tool_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "tool_id",
          "tool_name",
          "server_id"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "tool_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "server_id": {
            "type": "string"
          }
        }
      }
    },
    "gold_tool_set": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependency_depth": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "unknown"
        }
      ]
    },
    "required_tool_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool_id",
          "tool_name",
          "server_id",
          "sequence_positions",
          "dependency_depth"
        ],
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "server_id": {
            "type": "string"
          },
          "sequence_positions": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "dependency_depth": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "unknown"
              }
            ]
          }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "edge_type",
          "graph_provenance",
          "dependency_depth",
          "producer_tool",
          "producer_output_parameter",
          "consumer_tool",
          "consumer_input_parameter",
          "required",
          "optional",
          "internal_parameter",
          "value_semantics"
        ],
        "properties": {
          "edge_id": {
            "type": "string"
          },
          "edge_type": {
            "type": "string"
          },
          "graph_provenance": {
            "type": "string"
          },
          "dependency_depth": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "const": "unknown"
              }
            ]
          },
          "producer_tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_id",
              "tool_name"
            ],
            "properties": {
              "tool_id": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              }
            }
          },
          "producer_output_parameter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter_id",
              "parameter_name",
              "user_provided",
              "data_type"
            ],
            "properties": {
              "parameter_id": {
                "type": "string"
              },
              "parameter_name": {
                "type": "string"
              },
              "user_provided": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "const": "unknown"
                  }
                ]
              },
              "data_type": {
                "type": "string"
              }
            }
          },
          "consumer_tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_id",
              "tool_name"
            ],
            "properties": {
              "tool_id": {
                "type": "string"
              },
              "tool_name": {
                "type": "string"
              }
            }
          },
          "consumer_input_parameter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter_id",
              "parameter_name",
              "user_provided",
              "data_type"
            ],
            "properties": {
              "parameter_id": {
                "type": "string"
              },
              "parameter_name": {
                "type": "string"
              },
              "user_provided": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "const": "unknown"
                  }
                ]
              },
              "data_type": {
                "type": "string"
              }
            }
          },
          "required": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "optional": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "internal_parameter": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "value_semantics": {
            "type": "string"
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter_id",
          "tool_id",
          "tool_name",
          "role",
          "parameter_name",
          "user_provided",
          "required",
          "optional",
          "data_type"
        ],
        "properties": {
          "parameter_id": {
            "type": "string"
          },
          "tool_id": {
            "type": "string"
          },
          "tool_name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "input",
              "output"
            ]
          },
          "parameter_name": {
            "type": "string"
          },
          "user_provided": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "required": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "optional": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "unknown"
              }
            ]
          },
          "data_type": {
            "type": "string"
          }
        }
      }
    },
    "initial_scenario": {},
    "expected_final_state": {},
    "expected_final_scenario": {},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "relevant_subgraph_only",
        "stable_ids_use_python_object_identity",
        "metadata_preservation_point"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "relevant_subgraph_only": {
          "const": true
        },
        "stable_ids_use_python_object_identity": {
          "const": false
        },
        "metadata_preservation_point": {
          "type": "string"
        }
      }
    },
    "dependency_semantics": {
      "enum": [
        "selected_reference",
        "unique_possible_equals_selected",
        "possible_graph_unselected",
        "selected_reference_incomplete"
      ]
    },
    "alternative_dependency_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group_id",
          "semantics",
          "consumer_tool",
          "consumer_input_parameter",
          "alternatives",
          "selected_producer_tool",
          "selected_producer_output_parameter",
          "provenance",
          "resolution_status"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "semantics": {
            "const": "or"
          },
          "consumer_tool": {
            "type": "string"
          },
          "consumer_input_parameter": {
            "type": "string"
          },
          "alternatives": {},
          "selected_producer_tool": {
            "type": "string"
          },
          "selected_producer_output_parameter": {
            "type": "string"
          },
          "provenance": {
            "type": "string"
          },
          "resolution_status": {
            "enum": [
              "resolved",
              "unresolved_ambiguous_source_parameter",
              "unresolved_missing_graph_edge"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "expected_final_state_source": {
      "type": "string"
    },
    "selected_dependency_trace_present": {
      "type": "boolean"
    },
    "dependency_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "selected_dependency_count",
        "resolved_dependency_count",
        "unresolved_dependency_count",
        "cross_turn_dependency_count",
        "unresolved_dependencies"
      ],
      "properties": {
        "status": {
          "enum": [
            "resolved",
            "unresolved",
            "trace_missing"
          ]
        },
        "selected_dependency_count": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_dependency_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_dependency_count": {
          "type": "integer",
          "minimum": 0
        },
        "cross_turn_dependency_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trace_index",
              "resolution_status",
              "producer_tool",
              "consumer_tool",
              "consumer_input_parameter",
              "selected_producer_output_parameter",
              "candidate_edge_ids",
              "provenance"
            ],
            "properties": {
              "trace_index": {
                "type": "integer",
                "minimum": 0
              },
              "resolution_status": {
                "enum": [
                  "resolved",
                  "unresolved_ambiguous_source_parameter",
                  "unresolved_missing_graph_edge"
                ]
              },
              "producer_tool": {
                "type": "string"
              },
              "consumer_tool": {
                "type": "string"
              },
              "consumer_input_parameter": {
                "type": "string"
              },
              "selected_producer_output_parameter": {
                "type": "string"
              },
              "candidate_edge_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "provenance": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "cross_turn_dependency": {
      "type": "boolean"
    },
    "cross_turn_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trace_index",
          "resolution_status",
          "producer_tool",
          "consumer_tool",
          "consumer_input_parameter",
          "selected_producer_output_parameter",
          "candidate_edge_ids",
          "provenance"
        ],
        "properties": {
          "trace_index": {
            "type": "integer",
            "minimum": 0
          },
          "resolution_status": {
            "enum": [
              "resolved",
              "unresolved_ambiguous_source_parameter",
              "unresolved_missing_graph_edge"
            ]
          },
          "producer_tool": {
            "type": "string"
          },
          "consumer_tool": {
            "type": "string"
          },
          "consumer_input_parameter": {
            "type": "string"
          },
          "selected_producer_output_parameter": {
            "type": "string"
          },
          "candidate_edge_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "string"
          }
        }
      }
    },
    "structural_diagnosis_eligible": {
      "type": "boolean"
    },
    "probe_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "reasons",
        "checks",
        "state_diagnosis_available"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selected_dependency_trace_present",
            "all_selected_dependencies_resolved",
            "single_turn_structural_dependencies",
            "raw_tool_call_nonempty",
            "initial_state_available",
            "expected_final_state_available",
            "selected_reference_semantics"
          ],
          "properties": {
            "selected_dependency_trace_present": {
              "type": "boolean"
            },
            "all_selected_dependencies_resolved": {
              "type": "boolean"
            },
            "single_turn_structural_dependencies": {
              "type": "boolean"
            },
            "raw_tool_call_nonempty": {
              "type": "boolean"
            },
            "initial_state_available": {
              "type": "boolean"
            },
            "expected_final_state_available": {
              "type": "boolean"
            },
            "selected_reference_semantics": {
              "type": "boolean"
            }
          }
        },
        "state_diagnosis_available": {
          "type": "boolean"
        }
      }
    }
  }
}
